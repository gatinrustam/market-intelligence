{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_id",
    "provider",
    "symbol",
    "timestamps",
    "price",
    "spread",
    "quantity",
    "sequence",
    "exchange_event_basis",
    "ingestion_latency_ms"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "provider": {
      "const": "binance_spot"
    },
    "symbol": {
      "const": "BTCUSDT"
    },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_at",
        "exchange_event_at",
        "trade_received_at",
        "book_received_at"
      ],
      "properties": {
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "exchange_event_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "trade_received_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "book_received_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      }
    },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "last",
        "bid",
        "ask",
        "mid"
      ],
      "properties": {
        "last": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "bid": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "ask": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "mid": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        }
      }
    },
    "spread": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "absolute",
        "bps"
      ],
      "properties": {
        "absolute": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "bps": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        }
      }
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bid",
        "ask"
      ],
      "properties": {
        "bid": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "ask": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        }
      }
    },
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trade",
        "book"
      ],
      "properties": {
        "trade": {
          "type": "integer",
          "minimum": 0
        },
        "book": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "exchange_event_basis": {
      "const": "last_trade"
    },
    "ingestion_latency_ms": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://market-intelligence.local/contracts/market/snapshot/v1.schema.json",
  "title": "market.snapshot.v1"
}
