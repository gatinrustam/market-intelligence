# Local prototype only. Use URL-safe passwords or URL-encode the DB URL when overriding it.
MARIADB_PASSWORD=local_ingestion
MARIADB_ROOT_PASSWORD=local_root_only
INGESTION_PORT=8000
# Set a descriptive user agent with your own real contact for SEC access.
INGESTION_USER_AGENT=MarketIntelligencePrototype/0.1 (local research)
# Standalone app options (Compose config supplies URLs):
# INGESTION_DATABASE_URL=mysql+pymysql://ingestion:local_ingestion@localhost:3306/ingestion?charset=utf8mb4
# INGESTION_NATS_URL=nats://localhost:4222
# INGESTION_SOURCES_DIR=/absolute/path/config/sources
# INGESTION_SCHEMA_PATH=/absolute/path/contracts/news/raw/v1.schema.json
# INGESTION_HTTP_TIMEOUT_SECONDS=20
# Compose default accommodates the official MOEX archive RSS (~5.7 MB).
INGESTION_MAX_FEED_BYTES=10000000
# INGESTION_PUBLISHER_INTERVAL_SECONDS=1
# INGESTION_WORKERS_ENABLED=true

# Stage 1.5 — independent logical database and API
ENRICHMENT_DB_PASSWORD=local_enrichment
ENRICHMENT_PORT=8001
ENRICHMENT_USER_AGENT=MarketIntelligenceEnrichment/0.1
# Further ENRICHMENT_* options are documented in docs/architecture/content-enrichment.md.

EVENTS_DB_PASSWORD=local_events
EVENTS_PORT=8002

# Stage 3 — Market Data
MARKET_DATA_DB_PASSWORD=local_market_data
MARKET_DATA_PORT=8003
MARKET_DATA_SNAPSHOT_INTERVAL_SECONDS=1
MARKET_DATA_MAX_SNAPSHOT_DISTANCE_SECONDS=3

# Stage 3.5 — Market Context
MARKET_CONTEXT_DB_PASSWORD=local_market_context
MARKET_CONTEXT_PORT=8004

# Stage 4 decision projection freshness (seconds)
MARKET_CONTEXT_REALTIME_MAX_AGE_SECONDS=3
MARKET_CONTEXT_CANDLE_MAX_AGE_SECONDS=60

# Stage 4 (automatic live consumption is opt-in; never put keys in git)
LLM_ANALYSIS_DB_PASSWORD=local_llm_analysis
LLM_ANALYSIS_PORT=8005
LLM_ANALYSIS_MODEL=gpt-6-astra
LLM_ANALYSIS_REASONING_EFFORT=medium
LLM_ANALYSIS_AUTO_LIVE_ENABLED=false
OPENAI_API_KEY=

# Stage 4.5: separate dashboard auth (never share these with upstream services)
DASHBOARD_PORT=8006
DASHBOARD_APP_KEY=
DASHBOARD_ADMIN_EMAIL=research@local.test
DASHBOARD_ADMIN_PASSWORD=

# Stage 5 — deterministic evaluation; fixtures are isolated and excluded from real metrics.
EVALUATION_DB_PASSWORD=local_evaluation
EVALUATION_PORT=8007
EVALUATION_FIXTURES_ENABLED=false
EVALUATION_NEUTRAL_THRESHOLD_PCT=0.05
EVALUATION_NEGLIGIBLE_THRESHOLD_PCT=0.10
EVALUATION_SMALL_THRESHOLD_PCT=0.50
EVALUATION_MODERATE_THRESHOLD_PCT=1.50

# Stage 5.5 deterministic Event Intelligence (no provider calls)
EVENT_INTELLIGENCE_DB_PASSWORD=local_event_intelligence
EVENT_INTELLIGENCE_PORT=8008
EVENT_INTELLIGENCE_RULES_PATH=/workspace/config/event_intelligence/rules.v1.1.json

# DI-1: local NLP only; no LLM requests
DOCUMENT_INTELLIGENCE_DB_PASSWORD=local_document_intelligence
DOCUMENT_INTELLIGENCE_PORT=8009
DOCUMENT_INTELLIGENCE_RULES_PATH=/workspace/config/document_intelligence/rules.v1.json

ARTICLE_ROUTER_DB_PASSWORD=local_article_router
# Shared secret for authenticated dashboard review writes; generate a random value.
ARTICLE_ROUTER_REVIEW_TOKEN=

EVENT_RESEARCH_DB_PASSWORD=local_event_research
EVENT_RESEARCH_RULES_PATH=/workspace/config/event_research/rules.v2.json

# DI-4 immutable research correlation policy
EVENT_RESEARCH_CORRELATION_RULES_PATH=/workspace/config/event_research/correlation.v1.json

# DI-5 local CPU semantic analysis
ARTICLE_SEMANTIC_DB_PASSWORD=local_article_semantic
ARTICLE_SEMANTIC_REVIEW_TOKEN=
ARTICLE_SEMANTIC_WORKERS_ENABLED=true
