{
  "version": "semantic_crypto_v1_1",
  "threshold_version": "semantic_contrastive_v1",
  "chunking_version": "lossless_sentences_v1",
  "max_chunk_tokens": 192,
  "batch_size": 2,
  "concept_threshold": 0.48,
  "high_threshold": 0.62,
