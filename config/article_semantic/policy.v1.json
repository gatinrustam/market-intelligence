  "structure_type_signals": true,
  "gliner_dtype": "float32",
  "encoder_artifact": "bge/cpu_int8_per_channel.pt",
  "cpu_restore_policy": "fp32_non_embedding_v1",
  "embedding_healthcheck": "distinct_en_ru_v1",
