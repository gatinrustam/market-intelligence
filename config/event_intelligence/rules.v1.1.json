        "sec_press_releases"
      ],
      "title_patterns": [
        "(?i)^SEC Announces Departure of (?:Principal Deputy )?Director of Enforcement .+$"
      ],
      "relevance": "low",
      "specificity": "general"
    },
    {
      "id": "topic.digital_assets",
      "topics_any": [
        "digital_assets"
      ],
      "minimum_relevance": "high"
